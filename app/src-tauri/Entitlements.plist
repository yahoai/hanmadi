<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The app and its bundled ffmpeg are signed with the hardened runtime. There, Info.plist's
  NSMicrophoneUsageDescription alone isn't enough: without this entitlement microphone input is
  silently blocked. scripts/publish-macos.sh signs ffmpeg with this same file.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
